# Copy to .env and replace values needed for live analysis.
DEMO_SEED=true
FRONTEND_PORT=5173
COMPANIES_CSV_PATH=./docs/df_Uid_data_hack.csv
COMPANY_LINKS_CSV_PATH=./docs/df_Fid_Uid_link_hack.csv
COMPANY_PAYMENTS_CSV_PATH=./docs/df_Uid_payment_hack.csv
DATASET_KIND=anonymized
SERPER_API_KEY=
NEWS_REFRESH_INTERVAL=6h
# Optional comma-separated company IDs for scheduled refresh. Defaults to first 20.
NEWS_COMPANY_IDS=
LLM_BASE_URL=https://routerai.ru/api/v1
LLM_MODEL=GLM-5.3-Flash
LLM_API_KEY=
# Upper bound in RUB for one call, based on your provider contract and max_tokens.
LLM_RESERVED_RUB_PER_CALL=
LLM_MAX_RUB_PER_DAY=500
